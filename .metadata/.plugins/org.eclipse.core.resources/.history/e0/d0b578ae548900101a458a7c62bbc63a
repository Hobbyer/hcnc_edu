<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="sample.mapper.MainMapper">

	<select id="readUsers" resultType="java.util.HashMap">
		SELECT USER_ID, NAME, BIRTH_DAY, ADDRESS, LEVEL, POINT, IS_USE
			FROM USERS
	</select>
	
	<select id="getUser" parameterType="java.util.Map" resultType="java.util.HashMap">
		SELECT USER_ID, NAME, BIRTH_DAY, ADDRESS, LEVEL, POINT, IS_USE
			FROM USERS
			WHERE 1=1
			<if test="USER_ID != null and USER_ID != ''">
				AND USER_ID = #{USER_ID}
			</if>
			<if test="NAME != null and NAME != ''">
				AND NAME = #{NAME}
			</if>
			<if test="LEVEL != null and LEVEL != '' and LEVEL != '-전체-'">
				AND LEVEL = #{LEVEL}
			</if>
	</select>

	<select id="selectUser" parameterType="java.util.Map" resultType="java.util.HashMap">
		SELECT USER_ID, PASS, SALT
			FROM USERS
			WHERE 1=1
				AND USER_ID = #{user_id}
	</select>
	
	<select id="idChk" parameterType="java.util.Map" resultType="java.util.HashMap">
		SELECT USER_ID
			FROM USERS
			WHERE 1=1
				AND USER_ID = #{user_id}
	</select>
	
	<insert id="joinUser" parameterType="java.util.Map">
		INSERT INTO USERS (USER_ID, PASS, NAME, MAIL, ADDRESS, SALT, RECOMMEND_USER)
			VALUES (
				#{user_id}
				, #{user_pw}
				, #{user_name}
				, #{user_email}
				, #{user_addr}
				, #{user_salt}
				, #{user_recommend}
			)
	</insert>
	
	<insert id="createUser" parameterType="java.util.Map">
		INSERT INTO USERS (USER_ID, NAME, BIRTH_DAY, ADDRESS, LEVEL, POINT, IS_USE)
			VALUES(
				#{USER_ID}
				, #{NAME}
				, #{BIRTH_DAY}
				, #{ADDRESS}
				, #{LEVEL}
				, #{POINT}
				, #{IS_USE}
			)
	</insert>
	
	<update id="updateUser" parameterType="java.util.Map">
		UPDATE USERS 
			SET NAME = #{NAME}
				, BIRTH_DAY = #{BIRTH_DAY}
				, ADDRESS = #{ADDRESS}
				, LEVEL = #{LEVEL}
				, POINT = #{POINT}
				, IS_USE = #{IS_USE}
			WHERE USER_ID =#{USER_ID}
	</update>
	
</mapper>