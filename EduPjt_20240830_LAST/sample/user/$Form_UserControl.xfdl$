<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_UserControl" width="1280" height="720" titletext="New Form" onload="Form_UserControl_onload">
    <Layouts>
      <Layout height="720" width="1280">
        <Grid id="Grid00" taborder="0" left="0" top="160" right="0" bottom="0" binddataset="ds_users" autofittype="col">
