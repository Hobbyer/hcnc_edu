<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="Form_ProductControl" width="1280" height="720" titletext="New Form" onload="Form_ProductControl_onload" onsetfocus="Form_ProductControl_onload">
    <Layouts>
      <Layout height="720" width="1280">
